<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/dashboardFragment">

    <!-- Primary destinations (bottom navigation visible) -->
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.volatiledemandforecasting.feature.dashboard.DashboardFragment"
        android:label="@string/nav_dashboard" />
    <fragment
        android:id="@+id/productsFragment"
        android:name="com.example.volatiledemandforecasting.feature.products.ProductsFragment"
        android:label="@string/nav_products" />
    <fragment
        android:id="@+id/dataManagementFragment"
        android:name="com.example.volatiledemandforecasting.feature.data.DataManagementFragment"
        android:label="@string/nav_data" />
    <fragment
        android:id="@+id/forecastsFragment"
        android:name="com.example.volatiledemandforecasting.feature.forecasts.ForecastsFragment"
        android:label="@string/nav_forecasts" />

    <!-- Authentication (signed out; bottom navigation hidden) -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.volatiledemandforecasting.feature.auth.login.LoginFragment" />
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.volatiledemandforecasting.feature.auth.register.RegisterFragment" />
    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.example.volatiledemandforecasting.feature.auth.forgot.ForgotPasswordFragment" />

    <!-- Intro tour (first launch, and from Help); no app shell -->
    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.example.volatiledemandforecasting.feature.onboarding.OnboardingFragment" />

    <!-- Supporting destinations (bottom navigation hidden) -->
    <fragment
        android:id="@+id/workspacePickerFragment"
        android:name="com.example.volatiledemandforecasting.feature.workspace.WorkspacePickerFragment" />
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.volatiledemandforecasting.feature.settings.SettingsFragment" />
    <fragment
        android:id="@+id/teamFragment"
        android:name="com.example.volatiledemandforecasting.feature.team.TeamFragment" />
    <fragment
        android:id="@+id/myInvitationsFragment"
        android:name="com.example.volatiledemandforecasting.feature.team.MyInvitationsFragment" />
    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.example.volatiledemandforecasting.feature.settings.ChangePasswordFragment" />
    <fragment
        android:id="@+id/helpFragment"
        android:name="com.example.volatiledemandforecasting.feature.settings.HelpFragment" />
    <fragment
        android:id="@+id/createWorkspaceFragment"
        android:name="com.example.volatiledemandforecasting.feature.workspace.create.CreateWorkspaceFragment" />
    <fragment
        android:id="@+id/importWizardFragment"
        android:name="com.example.volatiledemandforecasting.feature.data.wizard.ImportWizardFragment" />
    <fragment
        android:id="@+id/readinessFragment"
        android:name="com.example.volatiledemandforecasting.feature.data.readiness.ReadinessFragment" />
    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.example.volatiledemandforecasting.feature.products.detail.ProductDetailFragment" />
    <fragment
        android:id="@+id/forecastConfigFragment"
        android:name="com.example.volatiledemandforecasting.feature.forecasts.config.ForecastConfigFragment" />
    <fragment
        android:id="@+id/forecastProgressFragment"
        android:name="com.example.volatiledemandforecasting.feature.forecasts.progress.ForecastProgressFragment" />
    <fragment
        android:id="@+id/forecastResultFragment"
        android:name="com.example.volatiledemandforecasting.feature.forecasts.result.ForecastResultFragment" />
    <fragment
        android:id="@+id/modelInfoFragment"
        android:name="com.example.volatiledemandforecasting.feature.model.ModelInfoFragment" />
    <fragment
        android:id="@+id/placeholderFragment"
        android:name="com.example.volatiledemandforecasting.feature.placeholder.PlaceholderFragment" />
    <fragment
        android:id="@+id/devGalleryFragment"
        android:name="com.example.volatiledemandforecasting.feature.devgallery.DevGalleryFragment"
        android:label="@string/screen_dev_gallery" />
</navigation>
