<?xml version="1.0" encoding="utf-8"?>
<!-- The session file is encrypted with a key that never leaves this device, so a restored copy is useless. Keep it out of backups. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_session.xml" />
    </device-transfer>
</data-extraction-rules>
